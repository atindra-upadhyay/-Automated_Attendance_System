{
  "name": "e-attend",
  "private": true,
  "scripts": {
    "start": "npm-run-all -p start:backend start:frontend",
    "start:backend": "cd backend-ready && node start-if-needed.js",
    "start:frontend": "cd frontend-ready && npm start",
    "install:all": "npm-run-all install:backend install:frontend",
    "install:backend": "cd backend-ready && npm install",
    "install:frontend": "cd frontend-ready && npm install"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.13",
    "concurrently": "^9.1.0",
    "npm-run-all": "^4.1.5"
  }
}
